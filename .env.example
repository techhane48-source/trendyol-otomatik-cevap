# Veritabanı (PostgreSQL)
# Yerel geliştirme: `npm run pg:dev` çıktısındaki adresi kullanın.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/trendyol_dev?schema=public"

# Trendyol entegrasyonu (gerçek değerleri .env dosyasına yazın, Git'e eklemeyin)
TRENDYOL_BASE_URL="https://apigw.trendyol.com/integration/qna"
TRENDYOL_SELLER_ID="000000"
TRENDYOL_API_KEY=""
TRENDYOL_API_SECRET=""
# Opsiyonel: boş bırakılırsa "{sellerId} - SelfIntegration" kullanılır.
# TRENDYOL_USER_AGENT="123456 - SelfIntegration"

# Senkronizasyon
SYNC_PAGE_SIZE="50"
SYNC_MAX_PAGES="100"
SYNC_MAX_RETRIES="3"
SYNC_RETRY_BASE_MS="500"

# HTTP
TRENDYOL_TIMEOUT_MS="15000"

# Panel/API erişim anahtarı (paylaşılan tek anahtar, en az 16 karakter).
# Boş bırakılırsa: geliştirmede erişim açık, ÜRETİMDE TÜM ERİŞİM KAPALI olur.
# Örnek üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ACCESS_TOKEN=""

# Log seviyesi: debug | info | warn | error
LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# LLM (cevap taslağı üretimi) — anahtar YALNIZCA .env içinde tutulur
disabled | mock | openai-compatible
LLM_PROVIDER="disabled"
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_TIMEOUT_MS="20000"
LLM_MAX_TOKENS="600"
LLM_TEMPERATURE="0.2"
LLM_PROMPT_VERSION="v1"

# Onaylayan/reddeden kişi adı (tek kiracılı kurulum)
ADMIN_ACTOR_NAME="admin"

# --- LLM güvenlik / maliyet ayarları (GÖREV 005) ---
# 429/5xx/ağ hatasında tekrar sayısı (0-3)
LLM_MAX_RETRIES=1
LLM_RETRY_BASE_MS=400
# 1K token başına USD fiyat — SABİT FİYAT VARSAYILMAZ, sağlayıcı listenize göre girin.
# Tanımlanmazsa maliyet 0 raporlanır.
LLM_INPUT_COST_PER_1K=0
LLM_OUTPUT_COST_PER_1K=0
