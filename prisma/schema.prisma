// Trendyol Soru Asistanı — Prisma şeması (FAZ 1: salt okunur)
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Trendyol satıcı (mağaza) kaydı.
model Store {
  id        String   @id @default(cuid())
  /// Trendyol sellerId (supplierId). Benzersizdir.
  sellerId  BigInt   @unique
  name      String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions        Question[]
  syncRuns         SyncRun[]
  productInfos     ProductInfo[]
  fieldSuggestions ProductFieldSuggestion[]
  catalogProducts  CatalogProduct[]
  policies         StorePolicy[]
  users            User[]
  settings         StoreSettings?
  integration      StoreIntegration?

  @@map("stores")
}

enum QuestionStatus {
  WAITING_FOR_ANSWER
  ANSWERED
  REJECTED
  UNKNOWN
}

/// Trendyol'dan çekilen müşteri sorusu. Salt okunur ayna kayıt.
model Question {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Trendyol soru kimliği. Mağaza bazında benzersizdir.
  trendyolQuestionId BigInt

  text      String
  status    QuestionStatus @default(UNKNOWN)
  /// Trendyol'daki ham durum metni
  rawStatus String?

  productName   String?
  productMainId String?
  productId     String?
  customerId    String?

  /// Varsa satıcının verdiği cevap (salt okunur ayna; gönderim yapılmaz)
  answerText String?

  /// Trendyol'daki oluşturma tarihi
  askedAt    DateTime?
  answeredAt DateTime?

  /// API'den gelen ham veri (ek alanlar dahil)
  raw Json?

  /// Geçmiş cevap doğrulama durumu (yalnızca answerText doluysa anlamlı)
  answerReviewStatus AnswerReviewStatus @default(UNREVIEWED)
  answerReviewNote   String?
  answerReviewedBy   String?
  answerReviewedAt   DateTime?

  firstSeenAt  DateTime @default(now())
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  drafts AnswerDraft[]

  @@unique([storeId, trendyolQuestionId])
  @@index([storeId, status])
  @@index([storeId, answerReviewStatus])
  @@index([askedAt])
  @@map("questions")
}

enum ProductInfoStatus {
  DRAFT
  VERIFIED
}

enum ProductInfoAction {
  CREATED
  UPDATED
  VERIFIED
  UNVERIFIED
}

/// Ürün bilgi kartı. Yalnızca `VERIFIED` kayıtlar AI taslağında kullanılır.
///
/// Eşleştirme anahtarı mağaza + ürün kimliğidir:
/// - `productMainId`: ürünün varyantlarını birleştiren üst kimlik (zorunlu)
/// - `productId`: tek bir varyantın kimliği (opsiyonel)
/// Böylece bir varyantın bilgisi başka varyanta karışmaz.
model ProductInfo {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  productMainId String
  /// Varyant kimliği; boşsa bilgi ana ürün düzeyindedir.
  productId     String?

  title      String?
  /// Doğrulanmış özellikler: [{ "label": "Kumaş", "value": "Bambu dokulu tül" }]
  attributes Json?
  notes      String?

  status     ProductInfoStatus @default(DRAFT)
  verifiedBy String?
  verifiedAt DateTime?
  createdBy  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events       ProductInfoEvent[]
  answerDrafts AnswerDraft[]

  @@unique([storeId, productMainId, productId])
  @@index([storeId, status])
  @@index([productMainId])
  @@map("product_infos")
}

/// Ürün bilgi kartındaki her değişikliğin geçmişi (kim, ne zaman, ne değişti).
/// Geçmiş satıcı cevaplarından çıkarılan ürün alanı adayı. İnsan onayı olmadan doğrulanmış sayılmaz.
model ProductFieldSuggestion {
  id            String  @id @default(cuid())
  storeId       String
  store         Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productMainId String
  productId     String?

  fieldKey          String
  value             String
  /// Kaynak soru kimlikleri (Trendyol)
  sourceQuestionIds Json
  /// Aynı alan için birbirini dışlayan (kesin çelişen) değer var mı?
  conflict          Boolean          @default(false)
  /// Çelişki yok ama değer belirsiz: insan incelemesi gerekir.
  needsReview       Boolean          @default(false)
  conflictValues    Json?
  status            SuggestionStatus @default(PENDING)
  reviewedBy        String?
  reviewedAt        DateTime?
  note              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, productMainId, status])
  @@map("product_field_suggestions")
}

model ProductInfoEvent {
  id            String      @id @default(cuid())
  productInfoId String
  productInfo   ProductInfo @relation(fields: [productInfoId], references: [id], onDelete: Cascade)

  action  ProductInfoAction
  actor   String
  note    String?
  /// Önceki değerler (değişiklik geçmişi); gizli bilgi içermez.
  changes Json?

  createdAt DateTime @default(now())

  @@index([productInfoId, createdAt])
  @@map("product_info_events")
}

enum DraftStatus {
  PENDING
  NEEDS_INFO
  APPROVED
  REJECTED
  SUPERSEDED
}

enum DraftSource {
  AI
  HUMAN_EDIT
}

enum DraftAction {
  CREATED
  EDITED
  APPROVED
  REJECTED
  SUPERSEDED
}

/// Mağaza işletme politikası (GÖREV 012). Ürün bilgisinden AYRI katman.
/// Politika metni yalnızca satıcı tarafından yazılır; doğrulanmadan AI'ya kesin bilgi olarak girmez.
model StorePolicy {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// POLICY_DEFS anahtarı (customSize, sizeRanges, sewing, accessories, orderChange, price)
  key   String
  value String @db.Text

  /// Satıcı onayı. false ise AI yalnızca "bilgi doğrulanmadı" diyebilir.
  verified   Boolean   @default(false)
  verifiedBy String?
  verifiedAt DateTime?

  /// MANUAL | IMPORT
  source String @default("MANUAL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, key])
  @@map("store_policies")
}

/// Cevap taslağı. Her düzenleme YENİ bir revizyon oluşturur; eski revizyonlar silinmez.
/// Bu tablo Trendyol'a hiçbir şey göndermez: onay yalnızca yerel durumu değiştirir.
model AnswerDraft {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  storeId    String

  /// Soru bazında 1'den başlayan revizyon numarası
  revision Int
  status   DraftStatus @default(PENDING)
  source   DraftSource @default(AI)

  /// Taslak metni (onaylandığında da değişmez; düzenleme yeni revizyon açar)
  text String

  /// Ürün bilgisi yokken metinde geçen doğrulanmamış ölçü/özellik iddiaları
  warnings Json?

  /// Üretimde kullanılan sağlayıcı/model (anahtar içermez)
  model         String?
  promptVersion String?

  /// Taslakta kullanılan ürün bilgi kartı (varsa)
  productInfoId String?
  productInfo   ProductInfo? @relation(fields: [productInfoId], references: [id], onDelete: SetNull)
  /// Eşleştirme sonucu: EXACT_VARIANT | MAIN_PRODUCT | AMBIGUOUS | MISSING
  productMatch  String?
  /// Taslakta kullanılan doğrulanmış bilgiler: [{ "label": "Kumaş", "value": "..." }]
  usedFacts     Json?
  /// Taslakta eksik/doğrulanmamış görünen bilgiler (insan onayı için)
  missingInfo   Json?

  /// GÖREV 016: taslakta kullanılan gerçek veri kaynakları [{ type, label, at }]
  contextSources Json?
  /// GÖREV 016: sipariş eşleşme sonucu (MATCHED | MISMATCH | UNVERIFIED | NOT_FOUND | UNAVAILABLE)
  orderMatch     String?

  /// Üretim ölçümleri (maliyet raporu için)
  durationMs       Int?
  inputTokens      Int?
  outputTokens     Int?
  totalTokens      Int?
  estimatedCostUSD Float?
  /// Token/maliyet değerleri sağlayıcıdan gelmediyse tahmin edildi mi?
  usageEstimated   Boolean @default(false)

  /// Taslakta yararlanılan geçmiş cevaplar (soru kimliği + benzerlik + gerekçe)
  historyUsed         Json?
  /// Doğrulanmış bilgiyle cevaplandı mı?
  resolution          DraftResolution?
  /// GÖREV 012 — algılanan soru niyeti (CUSTOM_SIZE, PRICE, ORDER_STATUS, ...)
  intent              String?
  /// GÖREV 012 — cevap stratejisi: DIRECT | PARTIAL | ASK_DETAIL | HUMAN_REVIEW
  strategy            String?
  /// Canlı fiyat/sipariş verisi gerektiren niyetlerde insan incelemesi şart
  requiresHumanReview Boolean          @default(false)
  /// Cevapta kullanılan doğrulanmış mağaza politikaları: [{ "label": ..., "value": ... }]
  policiesUsed        Json?

  createdBy  String?
  approvedBy String?
  approvedAt DateTime?
  rejectedBy String?
  rejectedAt DateTime?
  /// Onay/red sırasında girilen açıklama (uyarıların kabulü dahil)
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events DraftEvent[]

  @@unique([questionId, revision])
  @@index([questionId, status])
  @@index([storeId, status])
  @@map("answer_drafts")
}

/// Taslak üzerindeki her işlemin denetim kaydı (kim, ne zaman, ne yaptı).
model DraftEvent {
  id        String      @id @default(cuid())
  draftId   String
  draft     AnswerDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  action    DraftAction
  actor     String
  note      String?
  createdAt DateTime    @default(now())

  @@index([draftId, createdAt])
  @@map("draft_events")
}

enum SyncRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

/// Her senkronizasyon denemesinin kaydı: başlangıç, sonuç, sayaçlar, hata kodu.
model SyncRun {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  status  SyncRunStatus @default(RUNNING)
  trigger String        @default("manual")

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  fetchedCount Int @default(0)
  savedCount   Int @default(0)
  pagesFetched Int @default(0)

  /// Hata durumunda HTTP kodu (401/403/429/5xx vb.) veya hata sınıfı
  errorCode    String?
  /// Gizli bilgi içermeyen, kısaltılmış hata açıklaması
  errorMessage String?

  /// Kullanılan filtreler (status, tarih aralığı vb.)
  params Json?

  createdAt DateTime @default(now())

  @@index([storeId, startedAt])
  @@map("sync_runs")
}

/// Her LLM çağrısının (başarılı/başarısız) kullanım ve maliyet kaydı.
/// Anahtar, prompt metni veya müşteri verisi SAKLANMAZ.
model LlmUsage {
  id            String  @id @default(cuid())
  /// Mağaza kapsamı (eski kayıtlarda backfill ile dolar)
  storeId       String?
  provider      String
  model         String
  promptVersion String
  /// SUCCESS | ERROR | EMPTY
  outcome       String
  /// Hata durumunda güvenli kod (HTTP_429, TIMEOUT, INVALID_JSON ...)
  errorCode     String?

  durationMs       Int
  inputTokens      Int     @default(0)
  outputTokens     Int     @default(0)
  totalTokens      Int     @default(0)
  /// Sağlayıcı usage vermediyse tahmin edilir ve `estimated=true` olur.
  estimated        Boolean @default(false)
  estimatedCostUSD Float   @default(0)

  /// Çağrının bağlamı (müşteri verisi değil)
  draftId    String?
  questionId String?
  purpose    String  @default("draft")

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([provider, model])
  @@index([purpose])
  @@map("llm_usages")
}

/// Kalite değerlendirme seti (30–50 örnek).
model QualitySet {
  id                String   @id @default(cuid())
  storeId           String
  name              String
  createdBy         String
  /// Sabitlenen örnek soru kimlikleri (tekrar çalıştırmada aynı sorular kullanılır)
  sampleQuestionIds Json?
  sampleCount       Int      @default(0)
  createdAt         DateTime @default(now())

  runs QualityRun[]

  @@map("quality_sets")
}

/// Bir setin tek değerlendirme koşusu (prompt sürümü karşılaştırması için).
model QualityRun {
  id            String     @id @default(cuid())
  storeId       String
  setId         String
  set           QualitySet @relation(fields: [setId], references: [id], onDelete: Cascade)
  promptVersion String
  provider      String
  model         String
  /// RUNNING | COMPLETED | PARTIAL | FAILED
  status        String     @default("RUNNING")
  startedBy     String
  startedAt     DateTime   @default(now())
  finishedAt    DateTime?
  totalCostUSD  Float      @default(0)
  totalTokens   Int        @default(0)
  itemCount     Int        @default(0)

  items QualityItem[]

  @@index([setId, startedAt])
  @@map("quality_runs")
}

/// Değerlendirilen tek örnek: maskelenmiş soru, AI cevabı, otomatik kontroller, insan puanı.
model QualityItem {
  id         String     @id @default(cuid())
  runId      String
  run        QualityRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// Kaynak soru (silinmez; yalnızca referans)
  questionId String?

  /// Kişisel verileri maskelenmiş soru metni
  questionMasked String
  answerText     String
  /// Otomatik kontroller: warnings, eksik bilgi, vaat tespiti, üslup metrikleri
  autoChecks     Json?
  /// NEEDS_INFO / OK / EMPTY
  outcome        String @default("OK")
  inputTokens    Int    @default(0)
  outputTokens   Int    @default(0)
  costUSD        Float  @default(0)
  durationMs     Int    @default(0)

  humanScore  Int?
  humanNote   String?
  evaluatedBy String?
  evaluatedAt DateTime?

  createdAt DateTime @default(now())

  @@index([runId])
  @@map("quality_items")
}

/// Trendyol sipariş paketi (salt okunur ayna). Adres/telefon/ödeme verisi SAKLANMAZ.
model Order {
  id                     String    @id @default(cuid())
  storeId                String
  orderNumber            String
  shipmentPackageId      BigInt?
  /// Paket durumu (Created, Picking, Invoiced, Shipped, Delivered, Cancelled, Returned, UnPacked, Awaiting)
  status                 String
  rawStatus              String?
  orderedAt              DateTime?
  /// Kargo firması adı (Trendyol cargoProviderName)
  cargoProviderName      String?
  /// Kargo takip numarası — yalnızca müşteriye takip bilgisi vermek için; loglanmaz.
  cargoTrackingNumber    String?
  /// Kargo takip bağlantısı (varsa)
  cargoTrackingLink      String?
  /// Trendyol tahmini kargoya teslim aralığı (müşteriye teslim tarihi DEĞİLDİR)
  estimatedDeliveryStart DateTime?
  estimatedDeliveryEnd   DateTime?
  /// Satıcı ile mutabık teslim tarihi (varsa)
  agreedDeliveryDate     DateTime?
  /// Trendyol'da "Delivered" durumuna geçtiği zaman (varsa)
  deliveredAt            DateTime?
  /// Trendyol tarafındaki son değişiklik zamanı
  lastModifiedAt         DateTime?
  /// Bu kaydın Trendyol'dan son çekildiği an (tazelik göstergesi)
  fetchedAt              DateTime?
  /// Müşteri kimliğinin tuzlanmış özeti (düz metin PII saklanmaz)
  customerRef            String?
  syncedAt               DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  lines          OrderLine[]
  changeRequests OrderChangeRequest[]

  @@unique([storeId, orderNumber])
  @@index([storeId, status])
  @@index([shipmentPackageId])
  @@index([orderNumber])
  @@map("orders")
}

/// Sipariş kalemi. Ürün eşleştirmesi için kimlikler tutulur.
model OrderLine {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineId        String
  productId     String?
  productMainId String?
  productName   String?
  quantity      Int     @default(1)
  status        String?

  @@unique([orderId, lineId])
  @@index([productMainId])
  @@map("order_lines")
}

/// Geçmiş satıcı cevabının insan tarafından doğrulama durumu.
enum AnswerReviewStatus {
  UNREVIEWED
  VERIFIED
  WRONG
  OUTDATED
}

/// Taslak çözüm sınıfı: doğrulanmış bilgiyle mi cevaplandı?
enum DraftResolution {
  /// GÖREV 015: gerçekten cevaplandı (somut/doğrulanmış bilgi verildi)
  ANSWERED
  /// Kısmen cevaplandı: bir kısım bilgi verildi, kalanı eksik
  PARTIAL
  /// Gerekli bilgi eksik
  NEEDS_INFO
  /// İnsan kararı / gerçek işlem gerekiyor
  HUMAN_REVIEW
  /// Eski kayıtlar (geriye dönük uyumluluk)
  RESOLVED
  GENERIC
}

/// Geçmiş cevaplardan çıkarılan ürün alanı önerisinin durumu.
enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum OrderChangeStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  NEEDS_VERIFICATION
  INVALIDATED
}

enum OrderChangeAction {
  CREATED
  APPROVED
  REJECTED
  INVALIDATED
  VERIFICATION_REQUIRED
  OWNERSHIP_VERIFIED
  NOTE
}

/// Ölçü değişikliği talebi. Onay yalnızca yerel kayıttır; Trendyol'a hiçbir yazma yapılmaz.
model OrderChangeRequest {
  id                String  @id @default(cuid())
  storeId           String
  questionId        String?
  orderId           String?
  order             Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderNumber       String
  shipmentPackageId BigInt?
  /// Trendyol sipariş kalemi kimliği (harici; ilişki zorunlu değil)
  lineId            String?

  originalWidthCm   Int?
  originalHeightCm  Int?
  requestedWidthCm  Int?
  requestedHeightCm Int?

  /// En/boy yönü metinden kesin çıkarılamadıysa true
  orientationUncertain Boolean @default(false)

  status                OrderChangeStatus @default(PENDING_REVIEW)
  orderStatusAtRequest  String?
  orderStatusAtApproval String?
  /// Müşteri sahipliği API verisiyle doğrulanabildi mi?
  ownershipVerified     Boolean           @default(false)
  /// Sahiplik doğrulamasını kim, ne zaman yaptı (serbest metin notundan ayrı)
  ownershipVerifiedBy   String?
  ownershipVerifiedAt   DateTime?
  matchNote             String?

  createdBy  String?
  approvedAt DateTime?
  approvedBy String?
  rejectedAt DateTime?
  rejectedBy String?
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events OrderChangeEvent[]

  @@index([storeId, status])
  @@index([orderNumber])
  @@index([questionId])
  @@map("order_change_requests")
}

/// Talep denetim izi (audit).
model OrderChangeEvent {
  id        String             @id @default(cuid())
  requestId String
  request   OrderChangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  action    OrderChangeAction
  actor     String
  details   Json?
  createdAt DateTime           @default(now())

  @@index([requestId, createdAt])
  @@map("order_change_events")
}

/// Trendyol kataloğundan salt okunur çekilen ürün anlık görüntüsü (GÖREV 010).
/// Kaynak doğrudan Trendyol'dur; burada üretilen hiçbir bilgi doğrulanmış sayılmaz.
model CatalogProduct {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  productMainId String
  title         String?
  brand         String?
  categoryName  String?
  description   String? @db.Text
  barcodeSample String?

  /// Aynı productMainId altındaki barkod (varyant) sayısı.
  variantCount Int     @default(0)
  /// Sayfalama sınırına takıldıysa true: özellikler tüm varyantları kapsamaz.
  truncated    Boolean @default(false)

  /// Ortak/çoğunluk özellikler: [{ attributeId, name, value, share }]
  attributes     Json?
  /// Katalogda görülen benzersiz özellik adları (teşhis için).
  attributeNames Json?

  fetchedAt DateTime @default(now())
  lastError String?

  @@unique([storeId, productMainId])
  @@index([storeId])
  @@map("catalog_products")
}

// ---------------- GÖREV 017: akıllı iş kuyruğu ----------------

enum WorkCategory {
  AUTO_CANDIDATE
  SUPPORT
  WORKSHOP
  NEEDS_INFO
  HUMAN_REVIEW
  ACTION_REQUEST
}

enum WorkStatus {
  NEW
  IN_REVIEW
  APPROVED
  REJECTED
  DONE
}

enum WorkPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ProductionStage {
  NOT_STARTED
  CUTTING
  SEWING
  PACKED
  SHIPPED
}

/// Bir müşteri sorusunun operasyon karşılığı. Soru başına tek kayıt (idempotent).
model WorkItem {
  id         String @id @default(cuid())
  storeId    String
  questionId String @unique

  category WorkCategory
  /// Sorumlu ekip: "AI" | "Müşteri Temsilcisi" | "Atölye"
  team     String
  priority WorkPriority @default(NORMAL)
  status   WorkStatus   @default(NEW)

  /// Sınıflandırma gerekçeleri (açıklanabilir kurallar)
  reasons               Json?
  /// Sipariş numarası (varsa; panelde yalnızca yetkili oturuma gösterilir)
  orderNumber           String?
  /// MATCHED | MISMATCH | UNVERIFIED | NOT_FOUND | UNAVAILABLE
  orderMatch            String?
  /// Siparişin sınıflandırma anındaki Trendyol durumu
  orderStatusAtClassify String?
  /// Kullanılan bilgi kaynakları [{ type,label,at }]
  sources               Json?
  /// AI taslağı (varsa)
  draftId               String?

  /// Mağaza yapılandırmasındaki işlem türü anahtarı (ör. measure_change)
  requestTypeKey String?

  assignedTo String?

  /// Atölye üretim aşaması — Trendyol durumundan TAHMİN EDİLMEZ, elle işaretlenir.
  productionStage   ProductionStage?
  productionStageAt DateTime?
  productionStageBy String?

  firstReviewAt DateTime?
  closedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events WorkItemEvent[]

  @@index([storeId, status])
  @@index([storeId, category])
  @@index([storeId, priority])
  @@map("work_items")
}

model WorkItemEvent {
  id         String   @id @default(cuid())
  workItemId String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  /// CREATED | START_REVIEW | APPROVED | REJECTED | COMPLETED | STAGE_CHANGED
  action     String
  actor      String
  role       String
  note       String?
  createdAt  DateTime @default(now())

  @@index([workItemId, createdAt])
  @@map("work_item_events")
}

// ---------------- GÖREV 018: çok mağazalı SaaS altyapısı ----------------

enum UserRole {
  OWNER
  ADMIN
  SUPPORT
}

/// Mağaza kullanıcısı. Şifre yalnızca bcrypt hash olarak saklanır.
model User {
  id           String    @id @default(cuid())
  storeId      String
  email        String
  passwordHash String
  name         String?
  role         UserRole  @default(SUPPORT)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions Session[]
  attempts LoginAttempt[]
  store    Store          @relation(fields: [storeId], references: [id])

  @@unique([storeId, email])
  @@index([email])
  @@map("users")
}

/// Oturum. Ham token yalnızca çerezde; veritabanında SHA-256 özeti tutulur.
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ipHash     String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Giriş denemesi (hız sınırı ve denetim). E-posta düz metin tutulmaz.
model LoginAttempt {
  id        String   @id @default(cuid())
  emailHash String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  success   Boolean
  createdAt DateTime @default(now())

  @@index([emailHash, createdAt])
  @@map("login_attempts")
}

/// Mağaza bazlı yapılandırma: iş akışı kategorileri, sipariş kuralları, modüller.
model StoreSettings {
  id      String @id @default(cuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// [{ key, label, team, category, orderRule? }]
  workflow     Json?
  /// [{ key, label, description? }] — mağazanın işlem talep türleri
  requestTypes Json?
  /// { changeRequest: { allowedStatuses: [...], blockedStatuses: [...], unknown: "HUMAN_REVIEW" } }
  orderRules   Json?
  /// { showcase: boolean, catalog: boolean, changeRequests: boolean, workQueue: boolean }
  modules      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("store_settings")
}

// ---------------- GÖREV 020: mağaza bazlı Trendyol bağlantısı ----------------

enum IntegrationStatus {
  UNCONFIGURED
  CONNECTED
  ERROR
  DISABLED
}

/// Mağazanın Trendyol satıcı bağlantısı. Sırlar AES-256-GCM ile şifreli saklanır.
model StoreIntegration {
  id      String @id @default(cuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  sellerId BigInt
  apiKeyEnc String
  apiSecretEnc String
  /// Şifreleme anahtarı kimliği (rotasyon takibi; sır içermez)
  keyId String

  status IntegrationStatus @default(UNCONFIGURED)
  lastCheckAt DateTime?
  lastSuccessAt DateTime?
  /// Gizli veri içermeyen hata özeti
  lastError String?

  lastSyncAt DateTime?
  lastSyncStatus String?
  lastSyncError String?
  /// Aynı mağazada eşzamanlı senkronizasyonu engelleyen kilit
  syncLockedAt DateTime?

  disabledAt DateTime?
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("store_integrations")
}
