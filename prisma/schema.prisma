// Trendyol Soru Asistanı — Prisma şeması (FAZ 1: salt okunur)
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Trendyol satıcı (mağaza) kaydı.
model Store {
  id        String   @id @default(cuid())
  /// Trendyol sellerId (supplierId). Benzersizdir.
  sellerId  BigInt   @unique
  name      String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]
  syncRuns  SyncRun[]
  productInfos ProductInfo[]

  @@map("stores")
}

enum QuestionStatus {
  WAITING_FOR_ANSWER
  ANSWERED
  REJECTED
  UNKNOWN
}

/// Trendyol'dan çekilen müşteri sorusu. Salt okunur ayna kayıt.
model Question {
  id                 String         @id @default(cuid())
  storeId            String
  store              Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Trendyol soru kimliği. Mağaza bazında benzersizdir.
  trendyolQuestionId BigInt

  text               String
  status             QuestionStatus @default(UNKNOWN)
  /// Trendyol'daki ham durum metni
  rawStatus          String?

  productName        String?
  productMainId      String?
  productId          String?
  customerId         String?

  /// Varsa satıcının verdiği cevap (salt okunur ayna; gönderim yapılmaz)
  answerText         String?

  /// Trendyol'daki oluşturma tarihi
  askedAt            DateTime?
  answeredAt         DateTime?

  /// API'den gelen ham veri (ek alanlar dahil)
  raw                Json?

  firstSeenAt        DateTime       @default(now())
  lastSyncedAt       DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([storeId, trendyolQuestionId])
  @@index([storeId, status])
  @@index([askedAt])
  @@map("questions")

  drafts AnswerDraft[]
}

enum ProductInfoStatus {
  DRAFT
  VERIFIED
}

enum ProductInfoAction {
  CREATED
  UPDATED
  VERIFIED
  UNVERIFIED
}

/// Ürün bilgi kartı. Yalnızca `VERIFIED` kayıtlar AI taslağında kullanılır.
///
/// Eşleştirme anahtarı mağaza + ürün kimliğidir:
/// - `productMainId`: ürünün varyantlarını birleştiren üst kimlik (zorunlu)
/// - `productId`: tek bir varyantın kimliği (opsiyonel)
/// Böylece bir varyantın bilgisi başka varyanta karışmaz.
model ProductInfo {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  productMainId String
  /// Varyant kimliği; boşsa bilgi ana ürün düzeyindedir.
  productId String?

  title      String?
  /// Doğrulanmış özellikler: [{ "label": "Kumaş", "value": "Bambu dokulu tül" }]
  attributes Json?
  notes      String?

  status     ProductInfoStatus @default(DRAFT)
  verifiedBy String?
  verifiedAt DateTime?
  createdBy  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events       ProductInfoEvent[]
  answerDrafts AnswerDraft[]

  @@unique([storeId, productMainId, productId])
  @@index([storeId, status])
  @@index([productMainId])
  @@map("product_infos")
}

/// Ürün bilgi kartındaki her değişikliğin geçmişi (kim, ne zaman, ne değişti).
model ProductInfoEvent {
  id            String      @id @default(cuid())
  productInfoId String
  productInfo   ProductInfo @relation(fields: [productInfoId], references: [id], onDelete: Cascade)

  action  ProductInfoAction
  actor   String
  note    String?
  /// Önceki değerler (değişiklik geçmişi); gizli bilgi içermez.
  changes Json?

  createdAt DateTime @default(now())

  @@index([productInfoId, createdAt])
  @@map("product_info_events")
}

enum DraftStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum DraftSource {
  AI
  HUMAN_EDIT
}

enum DraftAction {
  CREATED
  EDITED
  APPROVED
  REJECTED
  SUPERSEDED
}

/// Cevap taslağı. Her düzenleme YENİ bir revizyon oluşturur; eski revizyonlar silinmez.
/// Bu tablo Trendyol'a hiçbir şey göndermez: onay yalnızca yerel durumu değiştirir.
model AnswerDraft {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  storeId    String

  /// Soru bazında 1'den başlayan revizyon numarası
  revision Int
  status   DraftStatus @default(PENDING)
  source   DraftSource @default(AI)

  /// Taslak metni (onaylandığında da değişmez; düzenleme yeni revizyon açar)
  text String

  /// Ürün bilgisi yokken metinde geçen doğrulanmamış ölçü/özellik iddiaları
  warnings Json?

  /// Üretimde kullanılan sağlayıcı/model (anahtar içermez)
  model         String?
  promptVersion String?

  /// Taslakta kullanılan ürün bilgi kartı (varsa)
  productInfoId String?
  productInfo   ProductInfo? @relation(fields: [productInfoId], references: [id], onDelete: SetNull)
  /// Eşleştirme sonucu: EXACT_VARIANT | MAIN_PRODUCT | AMBIGUOUS | MISSING
  productMatch  String?
  /// Taslakta kullanılan doğrulanmış bilgiler: [{ "label": "Kumaş", "value": "..." }]
  usedFacts     Json?
  /// Taslakta eksik/doğrulanmamış görünen bilgiler (insan onayı için)
  missingInfo   Json?

  createdBy  String?
  approvedBy String?
  approvedAt DateTime?
  rejectedBy String?
  rejectedAt DateTime?
  /// Onay/red sırasında girilen açıklama (uyarıların kabulü dahil)
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events DraftEvent[]

  @@unique([questionId, revision])
  @@index([questionId, status])
  @@index([storeId, status])
  @@map("answer_drafts")
}

/// Taslak üzerindeki her işlemin denetim kaydı (kim, ne zaman, ne yaptı).
model DraftEvent {
  id      String      @id @default(cuid())
  draftId String
  draft   AnswerDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  action  DraftAction
  actor   String
  note    String?
  createdAt DateTime  @default(now())

  @@index([draftId, createdAt])
  @@map("draft_events")
}

enum SyncRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

/// Her senkronizasyon denemesinin kaydı: başlangıç, sonuç, sayaçlar, hata kodu.
model SyncRun {
  id           String        @id @default(cuid())
  storeId      String
  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  status       SyncRunStatus @default(RUNNING)
  trigger      String        @default("manual")

  startedAt    DateTime      @default(now())
  finishedAt   DateTime?
  durationMs   Int?

  fetchedCount Int           @default(0)
  savedCount   Int           @default(0)
  pagesFetched Int           @default(0)

  /// Hata durumunda HTTP kodu (401/403/429/5xx vb.) veya hata sınıfı
  errorCode    String?
  /// Gizli bilgi içermeyen, kısaltılmış hata açıklaması
  errorMessage String?

  /// Kullanılan filtreler (status, tarih aralığı vb.)
  params       Json?

  createdAt    DateTime      @default(now())

  @@index([storeId, startedAt])
  @@map("sync_runs")
}
